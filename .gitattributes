# Явно нормализуем перевод строк для всех текстовых файлов — LF везде, вне зависимости от ОС
* text=auto eol=lf

# Исходники и конфиги мода
*.java text eol=lf
*.json text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows-скрипты — намеренно оставляем CRLF, иначе .bat не запустится в cmd
*.bat text eol=crlf
*.sh text eol=lf

# Бинарные файлы — не трогать вообще
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ogg binary
*.jar binary
*.class binary

# Disable autocrlf on generated files, they always generate with LF
src/generated/**/.cache/* text eol=lf
src/generated/**/*.json text eol=lf